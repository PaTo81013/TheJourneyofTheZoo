  <library_effects>
    <effect id="Body-Effect">
      <profile_COMMON>
        <newparam sid="Body-diffuse-surface">
          <surface type="2D">
            <init_from>Body-diffuse-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Body-emissive-surface">
          <surface type="2D">
            <init_from>Body-emissive-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Body-diffuse-sampler">
          <sampler2D>
            <source>Body-diffuse-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <newparam sid="Body-emissive-sampler">
          <sampler2D>
            <source>Body-emissive-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="phong1">
          <phong>
            <emission>
              <texture texcoord="Body-tex-bind" texture="Body-emissive-sampler"/>
            </emission>
            <ambient>
              <color>1.0 1.0 1.0 1.0</color>
            </ambient>
            <diffuse>
              <texture texcoord="Body-tex-bind" texture="Body-diffuse-sampler"/>
            </diffuse>
            <specular>
              <color>0.0 0.0 0.0 1.0</color>
            </specular>
            <shininess>
              <float>5.0</float>
            </shininess>
            <reflective>
              <color>1.0 1.0 1.0 1.0</color>
            </reflective>
            <reflectivity>
              <float>0.2</float>
            </reflectivity>
            <transparent>
              <color>1.0 1.0 1.0 1.0</color>
            </transparent>
            <transparency>
              <float>1.0</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
